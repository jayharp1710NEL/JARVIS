# ======================================================================
# JARVIS-LOCAL configuration — copy to .env and edit.
# Local-first & private by DEFAULT. Nothing leaves your machine unless
# you explicitly enable it below.
# ======================================================================

# ---- General ----
ENVIRONMENT=dev
LOG_LEVEL=INFO
# DATA_DIR=backend/data

# ---- Model provider (local by default) ----
# one of: ollama | openai_compatible | cloud
MODEL_PROVIDER=ollama

# Ollama (default local backend)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible local server (LM Studio / llama.cpp / vLLM / TGI)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=local-model

# Generation defaults
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=1024
CONTEXT_WINDOW=8192
REQUEST_TIMEOUT=120

# ---- Embeddings / RAG ----
# hashing (no download, default) | sentence_transformers | ollama
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
# numpy (default, local) | chroma
VECTOR_STORE=numpy
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=5

# ---- Web search ----
# searxng (default, local & private) | brave | tavily | serper | none
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8080
# Optional external providers (leave empty to keep disabled):
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_MAX_RESULTS=8

# ---- Cloud model (OFF by default) ----
# Setting this to true sends your prompts to an external API. Keep it false
# to stay fully local.
ENABLE_CLOUD_MODE=false
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini
# Even with cloud on, private files/memory stay local unless you allow this:
ALLOW_PRIVATE_DATA_TO_CLOUD=false

# ---- Security / privacy ----
# Hard switch: refuse ALL non-local network egress.
LOCAL_PRIVACY_MODE=false
# Code execution is sandboxed and DISABLED unless you turn it on.
ALLOW_CODE_EXECUTION=false
# WORKSPACE_DIR=backend/data/workspace

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
